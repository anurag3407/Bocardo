{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../packages/typescript-config/base.json",
  "compilerOptions": {
    // The suite is executed by `tsx` (esbuild) rather than `tsc`, and it loads
    // React Native / web packages such as `socket.io-client`. Bundler-style
    // resolution mirrors the app-side tsconfigs and avoids requiring the
    // `.js` extensions that `NodeNext` demands in ESM output.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext"],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["node"],
    "typeRoots": ["../node_modules/@types", "../apps/api/node_modules/@types"]
  },
  "include": ["./**/*.ts"]
}
