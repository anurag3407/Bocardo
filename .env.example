# Database (PostgreSQL 16 + PostGIS / Supabase)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bocardo"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/bocardo"

# Redis Cache & Socket PubSub
REDIS_URL="redis://localhost:6379"

# Fastify API Server
PORT=3000
NODE_ENV="development"
API_URL="http://localhost:3000"
SOCKET_URL="http://localhost:3000"

# Clerk Pro Authentication
CLERK_SECRET_KEY="sk_test_mock_clerk_secret_key"
CLERK_PUBLISHABLE_KEY="pk_test_mock_clerk_publishable_key"
CLERK_JWT_KEY="mock_jwt_key"

# Razorpay Payments (Webhook-Authoritative, Integer Paise)
RAZORPAY_KEY_ID="rzp_test_mock_key_id"
RAZORPAY_KEY_SECRET="mock_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="mock_webhook_secret"

# Expo Mobile Apps API Endpoint
EXPO_PUBLIC_API_URL="http://localhost:3000"
EXPO_PUBLIC_SOCKET_URL="http://localhost:3000"
EXPO_PUBLIC_RAZORPAY_KEY_ID="rzp_test_mock_key_id"

# Next.js Admin Ops Dashboard
NEXT_PUBLIC_API_URL="http://localhost:3000"
NEXT_PUBLIC_SOCKET_URL="http://localhost:3000"

# --- Production Hardening ---
# Comma-separated CORS allowlist (admin dashboard, web PWA origins)
ALLOWED_ORIGINS="http://localhost:3001"
# Global API rate limit per minute per user-token/IP
RATE_LIMIT_MAX=300
# Server-managed staff role grants (never trust client Clerk metadata):
# PRIVILEGED_ROLES="ops@bocardo.in:ADMIN,owner@biryanihouse.in:RESTAURANT"
PRIVILEGED_ROLES=""
# Durable BullMQ workers (always on in production; opt-in for local dev)
ENABLE_QUEUE_WORKERS="false"
# Clerk token verification (production): issuer/audience for RS256 JWTs
CLERK_ISSUER=""
CLERK_AUDIENCE=""
